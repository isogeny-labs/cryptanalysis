import "Modarith.cry";
m <- llvm_load_module "build/native.bc";

let arith_spec op delta = do {
    a <- llvm_fresh_var "a" (llvm_int 64);
    b <- llvm_fresh_var "b" (llvm_int 64);
    modulus <- llvm_fresh_var "modulus" (llvm_int 64);
    llvm_precond {{ valid a b modulus }};
    llvm_execute_func [llvm_term a, llvm_term b, llvm_term modulus];
    llvm_return (llvm_term {{ op a b modulus ^ delta }});
};
let check symbol op = do {
    llvm_verify m symbol [] false (arith_spec op {{ 0 : [64] }}) z3;
    fails (llvm_verify m symbol [] false (arith_spec op {{ 1 : [64] }}) z3);
    print symbol;
};
check "assay_ca_addmod" {{ add_mod }};
check "assay_ca_submod" {{ sub_mod }};

// Independent mathematical leg: 65-bit sums cannot overflow for 64-bit inputs.
// Adding m before subtraction is nonnegative because b < m.
prove_print z3 {{ \(a : [64]) (b : [64]) (modulus : [64]) ->
    valid a b modulus ==>
      widen (add_mod a b modulus) == (widen a + widen b) % widen modulus }};
fails (prove_print z3 {{ \(a : [64]) (b : [64]) (modulus : [64]) ->
    valid a b modulus ==>
      widen (add_mod a b modulus ^ 1) == (widen a + widen b) % widen modulus }});
prove_print z3 {{ \(a : [64]) (b : [64]) (modulus : [64]) ->
    valid a b modulus ==>
      widen (sub_mod a b modulus) == (widen a + widen modulus - widen b) % widen modulus }};
fails (prove_print z3 {{ \(a : [64]) (b : [64]) (modulus : [64]) ->
    valid a b modulus ==>
      widen (sub_mod a b modulus ^ 1) == (widen a + widen modulus - widen b) % widen modulus }});
print "ASSAY COMPLETE: production C to widened models to modular arithmetic";
