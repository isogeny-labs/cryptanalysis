+	// Signature of an integer-coded degrevlex monomial from a small
+	// thread-local direct-mapped cache: decoding the integer walks the
+	// combinatorial number system one variable at a time, and the same leading
+	// monomials and lcms are tested over and over inside update().
+	template<std::size_t N, std::size_t D, typename Int>
+	inline monomial_signature_t monomial_signature(const monomial_int_t < N, D, typename monomial_traits<N, D>::var_greater, monomial_degrevlex_less<N, D>, Int >& m)
+	{
+		// POD so the thread-local array is zero-initialised without a guard;
+		// key holds value + 1, so 0 marks an empty slot
+		struct entry_t { std::uint64_t key; monomial_signature_t sig; };
+		static const unsigned bits = 14;
+		static thread_local entry_t cache[std::size_t(1) << bits];
+		const std::uint64_t k = std::uint64_t(m.value()) + 1;
+		entry_t& e = cache[std::size_t((k * 0x9E3779B97F4A7C15ull) >> (64 - bits))];
+		if (e.key == k)
+			return e.sig;
+		e.key = k;
+		e.sig = monomial_signature_walk<N>(m);
+		return e.sig;
+	}
+
