+	// Divisibility signature of a monomial: m1 has bit (v mod 64) set when
+	// variable v occurs, m2 when it occurs with exponent >= 2; small says every
+	// exponent is <= 2 and no two variables share a bit (N <= 64).
+	//  - "a divides b" implies (a.m1 & ~b.m1) == 0 for every N, so m1 rejects
+	//    most non-divisors before the exact exponent walk, which for the
+	//    integer-coded monomials decodes one variable at a time;
+	//  - when a and b are both small, "a divides b" is exactly
+	//    (a.m1 & ~b.m1) == 0 && (a.m2 & ~b.m2) == 0, so no walk is needed.
+	//    Over GF(2) with the field equations every monomial is small.
+	struct monomial_signature_t
+	{
+		std::uint64_t m1, m2;
+		bool small;
+	};
+	template<std::size_t N, typename Mo>
+	inline monomial_signature_t monomial_signature_walk(const Mo& m)
+	{
+		monomial_signature_t s{ 0, 0, N <= 64 };
+		for (auto it = m.begin(); it != m.end(); ++it)
+		{
+			const std::uint64_t bit = std::uint64_t(1) << (unsigned(it->first) & 63u);
+			s.m1 |= bit;
+			if (it->second >= 2)
+			{
+				s.m2 |= bit;
+				if (it->second > 2)
+					s.small = false;
+			}
+		}
+		return s;
+	}
+	template<typename Mo>
+	inline monomial_signature_t monomial_signature(const Mo& m)
+	{
+		return monomial_signature_walk<Mo::max_vars>(m);
+	}
+	// 1: a divides b, 0: it does not, -1: undecided (walk the exponents)
+	template<typename Mo1, typename Mo2>
+	inline int monomial_divides_by_signature(const Mo1& a, const Mo2& b)
+	{
+		const monomial_signature_t sa = monomial_signature(a);
+		const monomial_signature_t sb = monomial_signature(b);
+		if ((sa.m1 & ~sb.m1) != 0)
+			return 0;
+		if (sa.small && sb.small)
+			return (sa.m2 & ~sb.m2) == 0 ? 1 : 0;
+		return -1;
+	}
+
