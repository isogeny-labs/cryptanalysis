digraph BooleanPilot {
  graph [rankdir=LR, bgcolor="white", fontname="DejaVu Sans", nodesep=0.35, ranksep=0.45];
  node [shape=box, style="rounded,filled", fillcolor="#e8f1fb", color="#3a5875", fontname="DejaVu Sans", fontsize=10];
  edge [color="#58718a", arrowsize=0.7];
  input [label="Frozen exact ANFs\n8 full-curve fixtures\n6,9,12 direct / 10 chained variables"];
  poly [label="Dinur multiple parity\nLPTWY decision + full search"];
  orders [label="Six real order layouts\nscalar F5 / M4RI + completion"];
  replay [label="m4 chained degree-4 matrix\nlearn / replay / checked fallback"];
  verify [label="Independent certificates\nall roots, staircase, S-pairs\npoint lifting and group law",fillcolor="#e7f3e9"];
  limits [label="CPU correctness only\nNo GPU speedup or exponent c\nNo deployed-curve conclusion",fillcolor="#fff0dc",color="#b08444"];
  input -> poly; input -> orders; input -> replay;
  poly -> verify; orders -> verify; replay -> verify;
  verify -> limits;
}
