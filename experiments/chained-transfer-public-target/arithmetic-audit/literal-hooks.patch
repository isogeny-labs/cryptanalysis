+    let to_mod = |v: i64| -> u64 { /* N4_AUDIT_SCALAR_CONVERSION */ n4_arithmetic_taps::hit("scalar.conversion", ell, "rem_u64", 1); if v < 0 { n4_arithmetic_taps::hit("scalar.conversion", ell, "neg", 1); } if v >= 0 { (v as u64) % ell } else { ell - ((-v) as u64 % ell) } };
