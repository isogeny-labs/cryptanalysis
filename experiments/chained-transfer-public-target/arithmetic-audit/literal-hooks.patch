+// Additive derivative-only private-primitive access. No algorithm uses this.
+pub fn arithmetic_audit_private_controls() {
+    let f = Fq {q:223, c_mul:Cell::new(0),c_inv:Cell::new(0),c_add:Cell::new(0)};
+    n4_arithmetic_taps::within("primitive-pic-mul", || assert_eq!(f.mul(7,9),63));
+    assert_eq!(f.c_mul.get(),1);
+    n4_arithmetic_taps::within("primitive-pic-mulu", || assert_eq!(f.mulu(7,9),63));
+    assert_eq!(f.c_mul.get(),1,"legacy mulu remains uncounted");
+    n4_arithmetic_taps::within("primitive-pic-add", || assert_eq!(f.add(220,9),6));
+    n4_arithmetic_taps::within("primitive-pic-sub", || assert_eq!(f.sub(7,9),221));
+    n4_arithmetic_taps::within("primitive-pic-subnc", || assert_eq!(f.sub_nc(7,9),221));
+    n4_arithmetic_taps::within("primitive-pic-neg", || assert_eq!(f.neg(7),216));
+    n4_arithmetic_taps::within("primitive-pic-invu", || assert_eq!(f.invu(2),112));
+    n4_arithmetic_taps::within("primitive-pic-inv", || assert_eq!(f.inv(2),112));
+    assert_eq!(f.c_inv.get(),1,"legacy invu remains uncounted");
+}
