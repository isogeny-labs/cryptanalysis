digraph campaign {
  graph [rankdir=LR, bgcolor="white", pad=0.25, nodesep=0.45, ranksep=0.65,
         label="PR #880 · proposed independent native CPU campaign v1\nNo timings collected",
         labelloc=t, fontsize=18, fontname="Helvetica"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, margin="0.16,0.10"];
  edge [fontname="Helvetica", fontsize=9, color="#536273", arrowsize=0.7];

  base [label="Pinned baseline\n9b45e8c8db2f078a…", fillcolor="#e7f0fa", color="#517ba5"];
  cand [label="Pinned candidate\n30dcdce8147d9b21…", fillcolor="#e7f0fa", color="#517ba5"];
  library [label="C library panel\n34 fingerprints\n1-thread + 2-thread rho\nA/A + Callgrind", fillcolor="#edf6ee", color="#52815a"];
  ecc [label="ECC2K-130 CPU panel\nf131 mul + sqr\ntable walk throughput\ncold check latency", fillcolor="#edf6ee", color="#52815a"];
  host [label="Tier 0 qualification\nphysical host · isolated cgroup\nfrequency / IRQ / NUMA / counters", fillcolor="#fff2dc", color="#aa7832"];
  affinity [label="Two-worker gate\nservice extension + affinity proof\nrequired for 2-thread panel", fillcolor="#fff2dc", color="#aa7832"];
  report [label="Report outputs\nraw records · plots · PDF\nbenchmark mirrors + impact audit", fillcolor="#f3eafa", color="#795998"];
  block [label="Current executor fails\ncontainer · quota · missing isolation\nno timing launched", fillcolor="#fdeaea", color="#a85858"];

  base -> library; cand -> library;
  base -> ecc; cand -> ecc;
  library -> host; ecc -> host;
  host -> report;
  library -> affinity [label="2-thread only"];
  affinity -> host;
  block -> host [style=dashed, label="qualification failure"];
}
