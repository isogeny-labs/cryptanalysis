digraph TransferScope {
  graph [rankdir=TB, bgcolor="white", nodesep=0.25, ranksep=0.35];
  node [shape=box, style="rounded,filled", fillcolor="#eef3f8", fontname="Latin Modern Roman", fontsize=10];
  edge [fontname="Latin Modern Roman", fontsize=9];
  source [label="Source model: F512 modulus 515\ny^2+xy=x^3+a*x^2+59, a=0/1\ntraces -35/+35; r=137/239\nNo selected subgroup generator"];
  restriction [label="A = Res(F512/F8) E\nWeil polynomial T^6-t*T^3+512"];
