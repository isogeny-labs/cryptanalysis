public theorem heckeMod7_minor_matches : ∀ i j : Fin 40,
    entry heckeMod7Minor i.val j.val =
      entry heckeMod7Rows i.val (heckeMod7Pivots.getD j.val 0) := by decide

public theorem heckeMod7_inverse_certificate : ∀ i j : Fin 40,
    ((List.range 40).foldl (fun total k =>
      total + entry heckeMod7Minor i.val k * entry heckeMod7Inverse k j.val) 0) % 7 =
      if i.val == j.val then 1 else 0 := by decide

