digraph G {
 graph [rankdir=TB,bgcolor="white",pad="0.15",nodesep="0.2",ranksep="0.32",fontname="Helvetica"];
 node [shape=box,style="rounded,filled",color="#45658a",fontname="Helvetica",fontsize=10,margin="0.1,0.08"];
 edge [color="#56718e",arrowsize=0.65];
 build [label="Final RTX4090 attempt\nsm89 build +CPU KAT pass\n8 positive fixture replays pass",fillcolor="#dcefdc"];
 device [label="CUDA device gate FAIL\nUnknown error /devices empty\nCause unestablished",fillcolor="#f6dedd"];
 skip [label="No GPU walk /KAT\nNo health /restart\nNo benchmark /challenge",fillcolor="#eeeeee"];
 gate [label="Original frontier NOT RUN\nEffective71 GB <192 GB gate\nTiny CPU controls pass",fillcolor="#fff0da"];
 close [label="Final inventory closeout\nFive known campaign IDs absent\nNo additional allocation",fillcolor="#e4ecf7"];
 {rank=same;build;device;skip;}
 {rank=same;gate;close;}
 build -> device [constraint=false];
 device -> skip [constraint=false];
 skip -> close;
 build -> gate;
 gate -> close [constraint=false];
}
