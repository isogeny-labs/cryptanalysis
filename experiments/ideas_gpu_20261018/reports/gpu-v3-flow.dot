digraph G {
 graph [rankdir=LR,bgcolor="white",pad="0.15",nodesep="0.2",ranksep="0.3",fontname="Helvetica"];
 node [shape=box,style="rounded,filled",color="#45658a",fontname="Helvetica",fontsize=10,margin="0.1,0.08"];
 edge [color="#56718e",arrowsize=0.65];
 build [label="GPU-v3 host\nCUDA build /host KAT\n8 positive fixture replays PASS",fillcolor="#dcefdc"];
 device [label="Device initialization FAIL\nCUDA unknown error\nRecovery Action: Reboot",fillcolor="#f6dedd"];
 skip [label="No GPU KAT /walk\nNo health /restart\nNo benchmark /challenge",fillcolor="#eeeeee"];
 frontier [label="Original large frontier NOT RUN\nEffective125 GB <required192 GB\nGate78; tiny controls pass",fillcolor="#fff0da"];
 cpu [label="Separate CPU-v3 request\nHTTP500 capacity refusal\nNo pod /no scientific run",fillcolor="#fff0da"];
 build -> device -> skip;
 build -> frontier;
 cpu -> frontier [style=dashed,arrowhead=none,label="separate request",fontsize=8];
}
