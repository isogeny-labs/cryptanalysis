+/* k * base as the sum of the stored 2^b * base over the set bits of k; each
+ * set bit is charged one operation, as ca_group_mul charges it. */
+static void rho_fb_mul(const rho_shared *sh, ca_elem *r, const ca_elem *pow, uint64_t k, uint64_t *ops)
+{
+    ca_elem acc;
+    ca_group_identity(sh->g, &acc);
+    for (int b = 0; k >> b; b++)
+        if ((k >> b) & 1) {
+            ca_group_op(sh->g, &acc, &acc, &pow[b]);
+            (*ops)++;
+        }
+    *r = acc;
+}
+#endif
+
+static void rho_start_mul(const rho_shared *sh, ca_elem *r, int use_target, uint64_t k, uint64_t *ops)
+{
+#ifdef CA_RHO_MEASURE_ARMS
+    if (sh->arm_fb) {
+        rho_fb_mul(sh, r, use_target ? sh->fb_target : sh->fb_base, k, ops);
+        return;
+    }
+#endif
+    ca_group_mul(sh->g, r, use_target ? &sh->target : &sh->base, k, ops);
+}
