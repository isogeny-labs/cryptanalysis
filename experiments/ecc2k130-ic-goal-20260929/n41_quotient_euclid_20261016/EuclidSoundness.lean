import Std
import Init.Grind.Ring.Basic

namespace QuotientEuclid
open Lean.Grind

/-- A value generated by the two input polynomials. In the application,
    `S` is the polynomial ring over `F[q]/G(q)`. -/
def generated {S : Type} [CommRing S] (h l x : S) : Prop :=
  ∃ u v : S, x = u * h + v * l

/-- A Euclidean remainder stays in the ideal generated by the inputs.
    The equation is the exact division identity, including every quotient
    coefficient computed using a unit pivot. -/
theorem remainder_generated {S : Type} [CommRing S]
    {h l a b q r : S} (ha : generated h l a)
    (hb : generated h l b) (division : a = q * b + r) :
    generated h l r := by
  rcases ha with ⟨ua, va, ha⟩
  rcases hb with ⟨ub, vb, hb⟩
  refine ⟨ua - q * ub, va - q * vb, ?_⟩
  rw [ha, hb] at division
  grind

/-- A unit final gcd gives a Bezout certificate. Any specialization of
    that certificate to a nontrivial field excludes a common root. -/
theorem unit_certificate_rejects {S F : Type}
    [CommRing S] [CommRing F]
    (φ : S → F) (h l u v : S)
    (map_add : ∀ x y, φ (x + y) = φ x + φ y)
    (map_mul : ∀ x y, φ (x * y) = φ x * φ y)
    (map_one : φ 1 = 1)
    (one_ne_zero : (1 : F) ≠ 0)
    (certificate : u * h + v * l = 1) :
    ¬ (φ h = 0 ∧ φ l = 0) := by
  intro common
  have mapped := congrArg φ certificate
  rw [map_add, map_mul, map_mul, common.1, common.2,
      map_one] at mapped
  have hz1 : φ u * (0 : F) = 0 := Semiring.mul_zero (φ u)
  have hz2 : φ v * (0 : F) = 0 := Semiring.mul_zero (φ v)
  rw [hz1, hz2, Semiring.add_zero] at mapped
  exact one_ne_zero mapped.symm

/-- Splitting the active code polynomial at a nonunit pivot preserves
    every allowed code in either the suspect factor or the quotient. -/
theorem split_covers_root {S F : Type}
    [CommRing S] [CommRing F]
    (φ : S → F) (active factor rest : S)
    (map_mul : ∀ x y, φ (x * y) = φ x * φ y)
    (no_zero_divisors : ∀ x y : F, x * y = 0 → x = 0 ∨ y = 0)
    (factorization : active = factor * rest)
    (root : φ active = 0) :
    φ factor = 0 ∨ φ rest = 0 := by
  have product_zero : φ factor * φ rest = 0 := by
    rw [← map_mul, ← factorization]
    exact root
  exact no_zero_divisors _ _ product_zero

#print axioms remainder_generated
#print axioms unit_certificate_rejects
#print axioms split_covers_root

end QuotientEuclid
