private def checks (key : Nat) : Bool := Id.run do
  let some (x,y) := witnesses[key]? | return false
  let some base := classify key 7 37 | return false
  let r := (x^3+2*x+14)%p
  return x < p && y ≤ p/2 && r != 0 && path 7 x == (key,340921998) &&
    y^2%p == (if base then r else p-r)

theorem certified_diagram :
    nodes.size = 36 ∧ witnesses.size = 128 ∧
    (List.range 128).all (fun k => classify k 7 37 ==
      some ((0x5ec55aed5ec7a5051ebd2a65e6d923ee : Nat).testBit k)) = true ∧
    (List.range 128).all checks = true ∧
    ((List.range 128).filter (fun k => classify k 7 37 == some true)).length = 71 := by
  decide +kernel

