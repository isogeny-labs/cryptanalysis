private def p : Nat := 2147483647
private def forward (x : Nat) := (x*x + p-2) % p
private def path : Nat → Nat → Nat × Nat
  | 0, x => (0,x)
  | n+1, x =>
    let (bits, terminal) := path n (forward x)
    ((if p/2 < x then 1 else 0) + 2*bits,terminal)

