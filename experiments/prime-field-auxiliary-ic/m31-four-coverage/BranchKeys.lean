private def classify (key : Nat) : Nat → Nat → Option Bool
  | _, 0 => some false
  | _, 1 => some true
  | 0, _+2 => none
  | n+1, i+2 => do
    let (bit,lo,hi) ← nodes[i]?
    classify key n (if key.testBit bit then hi else lo)

