private def deposit (mask v : Nat) : Nat :=
  ((List.range 7).foldl (fun (acc,rest) j =>
    if mask.testBit j then (acc + (rest%2)*2^j,rest/2) else (acc,rest)) (0,v)).1

private def bitCount (s : Nat) := ((List.range 7).filter (s.testBit ·)).length
private def label : Nat := 0x5ec55aed5ec7a5051ebd2a65e6d923ee

private def encoded (c : Entry) : Bool := Id.run do
  let (s,rows,dual) := c
  if rows.size != 2^(bitCount s) || dual.size != rows.size then return false
  for i in [:rows.size] do
    for j in [:128/rows.size] do
      if rows[i]!.testBit j != label.testBit (deposit s i + deposit (127-s) j) then return false
  return true

theorem masks_and_labels :
    (certs.map (·.1)).toList = (List.range 128).filter (fun s => bitCount s ≤ 3) ∧
    certs.all encoded = true := by decide +kernel

private def bit (v j : Nat) : ZMod 2 := if v.testBit j then 1 else 0
private def unfolding (c : Entry) : Matrix (Fin c.2.1.size) (Fin (128/c.2.1.size)) (ZMod 2) :=
  fun i j => bit c.2.1[i] j
private def dualMatrix (c : Entry) : Matrix (Fin (128/c.2.1.size)) (Fin c.2.1.size) (ZMod 2) :=
  fun i j => bit c.2.2[j.val]! i

private def rightInverse (c : Entry) :=
  ∀ i j : Fin c.2.1.size, (unfolding c * dualMatrix c) i j = (1 : Matrix _ _ (ZMod 2)) i j

private instance (c : Entry) : Decidable (rightInverse c) :=
  @Fintype.decidableForallFintype _ _ (fun _ =>
    @Fintype.decidableForallFintype _ _ (fun _ => inferInstanceAs (Decidable ((_ : ZMod 2) = _))) _) _

set_option maxRecDepth 4096 in
set_option maxHeartbeats 4000000 in
private theorem all_inverses (i : Fin certs.size) : rightInverse certs[i] := by
  revert i
  decide +kernel

theorem cut_width (i : Fin certs.size) (w : Nat)
    (L : Matrix (Fin certs[i].2.1.size) (Fin w) (ZMod 2))
    (R : Matrix (Fin w) (Fin (128/certs[i].2.1.size)) (ZMod 2))
    (factorization : unfolding certs[i] = L*R) : certs[i].2.1.size ≤ w := by
  have h : unfolding certs[i] * dualMatrix certs[i] = 1 := Matrix.ext (all_inverses i)
  rw [factorization] at h
  calc
    _ = (1 : Matrix (Fin certs[i].2.1.size) (Fin certs[i].2.1.size) (ZMod 2)).rank := by rw [Matrix.rank_one, Fintype.card_fin]
    _ = ((L*R)*dualMatrix certs[i]).rank := by rw [h]
    _ ≤ (L*R).rank := Matrix.rank_mul_le_left _ _
    _ ≤ L.rank := Matrix.rank_mul_le_left _ _
    _ ≤ w := Matrix.rank_le_width _

