def tier (f : List Nat) : Nat :=
  if f.all (· ≤ 256) then 0 else if f.all (· ≤ 1024) then 1
  else if f.all (· ≤ 4096) then 2 else 3

def valid (r : Row) : Bool := Id.run do
  let (i,j,base,x,z,left,right) := r
  let rhs := (x^3+2*x+14) % p
  return 0 < x && x < p && 0 < rhs && z < p &&
    left.prod == x && right.prod == p-x &&
    left.all (fun q => decide (Nat.Prime q)) && right.all (fun q => decide (Nat.Prime q)) &&
    tier left == i && tier right == j && z^2 % p == (if base then rhs else p-rhs)

theorem checked : rows.all valid = true := by native_decide

theorem coverage : ∀ i j : Fin 4, ∀ b : Bool,
    rows.any (fun r => r.1 == i.val && r.2.1 == j.val && r.2.2.1 == b) = true := by
  decide +kernel

