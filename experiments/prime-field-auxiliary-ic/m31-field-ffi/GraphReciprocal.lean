def rawTable : Array Nat := Array.ofFn fun i : Fin 4096 => tableWord rawBlock i.val

def rawLookup (y : F) : F :=
  let v := y.val
  let x := v
  let left := x % 2048
  let right := 2048 + ((x*2654435787) % 2^32) / 2^21
  let r := tableWord rawBlock left ^^^ tableWord rawBlock right
  (r : F)

