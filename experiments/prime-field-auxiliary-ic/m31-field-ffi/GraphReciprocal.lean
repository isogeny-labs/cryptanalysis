def signedTable : Array Nat := Array.ofFn fun i : Fin 2048 => tableWord signedBlock i.val

def signedLookup (y : F) : F :=
  let v := y.val
  let x := min v (2147483647-v)
  let left := x % 1024
  let right := 1024 + ((x*2654435769) % 2^32) / 2^22
  let r := tableWord signedBlock left ^^^ tableWord signedBlock right
  ((if x = v then r else r ^^^ 2147483647 : Nat) : F)
theorem generator_order : IsPrimitiveRoot gen 2046 := by
  apply IsPrimitiveRoot.iff_orderOf.mpr
  apply orderOf_eq_of_pow_and_pow_div_prime (by decide)
  · decide +kernel
  intro q prime dvd
  change q ∣ 2 * 3 * 11 * 31 at dvd
  rw [prime.dvd_mul, prime.dvd_mul, prime.dvd_mul] at dvd
  rcases dvd with ((h | h) | h) | h <;>
    (obtain rfl := (Nat.prime_dvd_prime_iff_eq prime (by decide)).mp h; decide +kernel)

theorem lookup_correct (lookup : F → F)
    (checked : ∀ j : Fin 2046, lookup (gen^j.val) * gen^j.val = 1)
    (x : F) (hx : x ≠ 0) : x^1049600 * lookup (x^1049601) = x⁻¹ := by
  have hpow : (x^1049601)^2046 = 1 := by
    rw [← pow_mul]
    simpa only [ZMod.card] using FiniteField.pow_card_sub_one_eq_one x hx
  obtain ⟨i, hi, eq⟩ := generator_order.eq_pow_of_pow_eq_one hpow
  have h := checked ⟨i,hi⟩
  change lookup (gen^i) * gen^i = 1 at h
  rw [eq] at h
  apply (mul_left_inj' hx).mp
  calc
    _ = lookup (x^1049601) * (x^1049600 * x) := by rw [mul_right_comm, mul_comm (x^1049600 * x)]
    _ = 1 := by rwa [← pow_succ]
    _ = x⁻¹ * x := (inv_mul_cancel₀ hx).symm

set_option maxRecDepth 65536 in
set_option maxHeartbeats 8000000 in
theorem raw_correct (x : F) (hx : x ≠ 0) :
    x^1049600 * rawLookup (x^1049601) = x⁻¹ :=
  lookup_correct _ (by decide +kernel) x hx

set_option maxRecDepth 65536 in
set_option maxHeartbeats 8000000 in
theorem signed_correct (x : F) (hx : x ≠ 0) :
    x^1049600 * signedLookup (x^1049601) = x⁻¹ :=
  lookup_correct _ (by decide +kernel) x hx

/-- Both graph encodings give total field inversion, including the zero input. -/
theorem both_correct (x : F) :
    x^1049600 * rawLookup (x^1049601) = x⁻¹ ∧
    x^1049600 * signedLookup (x^1049601) = x⁻¹ := by
  by_cases hx : x = 0
  · subst x
    simp
  · exact ⟨raw_correct x hx, signed_correct x hx⟩

end M31GraphReciprocal

#print axioms M31GraphReciprocal.generator_order
#print axioms M31GraphReciprocal.both_correct
