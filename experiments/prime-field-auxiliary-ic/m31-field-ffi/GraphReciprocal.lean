import Mathlib.NumberTheory.LucasLehmer
import Mathlib.RingTheory.RootsOfUnity.PrimitiveRoots

namespace M31GraphReciprocal
abbrev F := ZMod 2147483647
local instance : Fact (Nat.Prime 2147483647) :=
  ⟨lucas_lehmer_sufficiency 31 (by decide) (by norm_num)⟩
abbrev gen : F := 1448159583

/-- Each block packs 64 graph labels, least significant word first. -/
private def tableWord (blocks : Nat → Nat) (index : Nat) : Nat :=
  (blocks (index / 64) >>> (32 * (index % 64))) % 2^32

