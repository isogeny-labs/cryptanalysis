ring source=127,(x2,x1),dp;
short=0;
poly targetX=97;
option(redSB);
ideal inputIdeal=1*x1^0+24*x1^1+1*x1^2+20*x1^3+99*x1^4+20*x1^5+1*x1^6+24*x1^7+1*x1^8,
1*x2^0+24*x2^1+1*x2^2+20*x2^3+99*x2^4+20*x2^5+1*x2^6+24*x2^7+1*x2^8,
((x1)-(x2))^2*(targetX)^2-2*(((x1)+(x2))*((x1)*(x2)+(2))+2*(51))*(targetX)+((x1)*(x2)-(2))^2-4*(51)*((x1)+(x2));
ideal G=std(inputIdeal);
print("@@GB_DONE@@");
print("@@DIM@@"+string(dim(G)));
ring result=127,(x2,x1),lp;
