+#[cfg(test)]
+mod paired_probe_tests {
+    use super::*;
+
+    fn compare<const B: u32>(curve: Curve<B>, roots: &[u64], targets: &[Point]) {
+        let base = FactorBase::without_maps(curve, roots).unwrap();
+        let paired = PairIndex::new(&base, 4_194_304, 64).unwrap();
+        let generic = PairIndex::new(&base, 4_194_304, 63).unwrap();
+        for &target in targets {
+            let actual = paired.decompose(3, target, &mut paired.workspace()).unwrap();
+            let expected = generic
+                .decompose(3, target, &mut generic.workspace())
+                .unwrap();
+            assert_eq!(actual, expected, "target={target:?}");
+        }
+    }
+
+    #[test]
+    fn paired_filtered_three_sum_matches_odd_chunk_on_complete_small_curve() {
+        let curve = Curve::<7>::new(2, 51).unwrap();
+        let roots: Vec<_> = (0..curve.modulus())
+            .filter(|&x| curve.lift_x(x).unwrap().is_some())
+            .take(8)
+            .collect();
+        let mut targets = Vec::new();
+        for x in 0..curve.modulus() {
+            if let Some(point) = curve.lift_x(x).unwrap() {
+                targets.push(point);
+                targets.push(curve.negate(point).unwrap());
+            }
+        }
+        compare(curve, &roots, &targets);
+    }
+
+    #[test]
+    fn paired_three_sum_matches_generic_without_bitmap() {
+        let curve = Curve::<31>::new(2, 14).unwrap();
+        let roots: Vec<_> = (0..curve.modulus())
+            .filter(|&x| curve.lift_x(x).unwrap().is_some())
+            .take(385)
+            .collect();
+        let g = curve.point(1, 814455902).unwrap();
+        let targets: Vec<_> = [1, 2, 3, 17, 12345, 123456789]
+            .into_iter()
+            .map(|k| curve.mul(Some(g), k).unwrap().unwrap())
+            .collect();
+        compare(curve, &roots, &targets);
+    }
+}
