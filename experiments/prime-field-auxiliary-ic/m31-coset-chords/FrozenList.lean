/-- The twist is written in the same x-coordinate as -y² = x³+2x+14. -/
inductive Side where
  | original | twist | both | neither | infinity
  deriving DecidableEq

def side : E.Point → Side
  | .zero => .infinity
  | .some (x := x) _ =>
    let rhs := x^3+2*x+14
    let y := PublicLift.squares rhs 29
    -- Exponent 2^29 is even, so the two root candidates coincide.
    let v := y*y
    match decide (v=rhs), decide (v= -rhs) with
    | true,false => .original
    | false,true => .twist
    | true,true => .both
    | false,false => .neither

theorem twist_candidate (rhs : F) : PublicLift.squares (-rhs) 29 = PublicLift.squares rhs 29 := by
  rw [PublicLift.exponent, PublicLift.exponent]
  exact Even.neg_pow (by decide : Even (2^29 : Nat)) rhs

def sides (pt : E.Point) : Nat → List Side
  | 0 => []
  | k+1 => side pt :: sides (pt+G) k

set_option maxRecDepth 8192 in
set_option maxHeartbeats 4000000 in
theorem split_counts :
    let results := sides T 1024
    (results.count .original, results.count .twist, results.count .both,
      results.count .neither, results.count .infinity) = (500,524,0,0,0) := by decide +kernel

#print axioms exact_list
#print axioms split_counts
end M31List
