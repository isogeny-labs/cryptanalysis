namespace M31List
def lift (x : F) : Option (Nat × Nat) :=
  let rhs := x^3+2*x+14
  let y := PublicLift.squares rhs 29
  if y*y = rhs then some (x.val,(PublicLift.smaller y).val) else none

def atPoint : E.Point → Option (Nat × Nat)
  | .zero => none
  | .some (x := x) _ => lift x

def walk (pt : E.Point) : Nat → List (Nat × Nat)
  | 0 => []
  | n+1 =>
    let tail := walk (pt+G) n
    match atPoint pt with
    | none => tail
    | some p => p :: tail

