digraph Result {
  graph [rankdir=TB, bgcolor="white", pad="0.25"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, fillcolor="#e8f2ff"];
  edge [fontname="Helvetica", fontsize=10];
