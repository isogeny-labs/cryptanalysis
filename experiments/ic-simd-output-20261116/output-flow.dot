digraph output {
 rankdir=LR; bgcolor="white"; node [shape=box,style="rounded,filled",fillcolor="#edf5f4",fontname="Helvetica"]; edge [fontname="Helvetica",fontsize=10];
 input [label="Four normal cached pairs\nSame numerator, inverse and field formula"];
 lanes [label="SIMD abscissae\nExact four u64 values"];
 array [label="Fixed array of four Some(x_i) values\nSafe slice append to existing output"];
 fallback [label="Exceptional groups and tails\nExisting scalar fallback"];
 result [label="Same ordered Option<u64> output\nPrefix retained; no arithmetic change"];
 input -> lanes -> array -> result;
 input -> fallback [label="non-normal pair"];
 fallback -> result;
}
