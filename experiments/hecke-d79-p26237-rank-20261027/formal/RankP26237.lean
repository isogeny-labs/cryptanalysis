    entry hecke3Minor i.val j.val =
      entry hecke3Rows i.val (hecke3Pivots.getD j.val 0) := by decide

public theorem hecke3_inverse_certificate : ∀ i j : Fin 35,
    ((List.range 35).foldl (fun total k =>
      total + entry hecke3Minor i.val k * entry hecke3Inverse k j.val) 0) % 3 =
      if i.val == j.val then 1 else 0 := by decide

