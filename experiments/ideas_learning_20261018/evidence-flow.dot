digraph evidence {
  graph [rankdir=LR, bgcolor="white", label="CPU correctness controls: evidence and limits", labelloc=t, fontsize=18];
  node [shape=box, style="rounded,filled", fillcolor="#edf2f7", fontname="Helvetica", fontsize=11];
  edge [color="#566578"];
  frozen [label="Frozen protocol\nsource/input hashes"];
  exact [label="Exact curves/subgroups\nall toy targets"];
  train [label="Training selection\nsearch costs retained"];
  held [label="Reserved holdouts\nindependent replay"];
  gaps [label="Original criteria still open\nno IC/security promotion", fillcolor="#fee8d5"];
  frozen -> exact -> train -> held -> gaps;
  archive [label="1,718 archived receipts\n4 incomplete retained"];
  shape [label="Shape holdout\nempirical intervals only"];
  curves [label="Whole-curve holdout\n3 calibration curves"];
  unbound [label="90% group bound\nunbounded", fillcolor="#fee8d5"];
  archive -> shape -> curves -> unbound -> gaps;
}
