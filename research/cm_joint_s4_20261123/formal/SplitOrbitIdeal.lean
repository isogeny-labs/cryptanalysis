import Mathlib.RingTheory.Ideal.Operations

/-!
The finite split orbit algebra is a product of fields. A point-selected
maximal ideal is generated by the idempotent that vanishes at its selected
coordinate and equals one at every other coordinate. This theorem proves
the ideal idempotence in the product presentation. The Chinese remainder
identification of the orbit polynomial quotient with this product, and the
claim about the Picard group, are stated separately in the report.
-/

namespace SplitOrbitIdeal

variable {ι F : Type*} [DecidableEq ι] [Field F]

def complementIdempotent (i : ι) : (ι → F) :=
  fun j => if j = i then 0 else 1

def pointIdeal (i : ι) : Ideal (ι → F) :=
  Ideal.span {complementIdempotent i}

theorem complementIdempotent_mul_self (i : ι) :
    complementIdempotent (F := F) i * complementIdempotent i =
      complementIdempotent i := by
  funext j
  by_cases h : j = i <;> simp [complementIdempotent, h]

theorem pointIdeal_mul_self (i : ι) :
    pointIdeal (F := F) i * pointIdeal i = pointIdeal i := by
  simp [pointIdeal, Ideal.span_singleton_mul_span_singleton,
    complementIdempotent_mul_self]

theorem mem_pointIdeal_iff (i : ι) (f : ι → F) :
    f ∈ pointIdeal i ↔ f i = 0 := by
  constructor
  · intro hf
    obtain ⟨g, hg⟩ := Ideal.mem_span_singleton'.mp hf
    have h := congrArg (fun h : ι → F => h i) hg
    simpa [complementIdempotent] using h.symm
  · intro hf
    apply Ideal.mem_span_singleton'.mpr
    refine ⟨f, ?_⟩
    funext j
    by_cases h : j = i
    · subst j
      simp [complementIdempotent, hf]
    · simp [complementIdempotent, h]

theorem pointIdeal_ne_top (i : ι) : pointIdeal (F := F) i ≠ ⊤ := by
  intro h
  have hmem : (1 : ι → F) ∈ pointIdeal i := by rw [h]; simp
  have hzero := (mem_pointIdeal_iff i 1).mp hmem
  norm_num at hzero

theorem pointIdeal_not_invertible (i : ι) :
    ¬ ∃ J : Ideal (ι → F), pointIdeal i * J = ⊤ := by
  rintro ⟨J, h⟩
  have hle : (⊤ : Ideal (ι → F)) ≤ pointIdeal i := by
    rw [← h]
    exact Ideal.mul_le_right
  exact pointIdeal_ne_top i (top_le_iff.mp hle)

#print axioms SplitOrbitIdeal.complementIdempotent_mul_self
#print axioms SplitOrbitIdeal.pointIdeal_mul_self
#print axioms SplitOrbitIdeal.mem_pointIdeal_iff
#print axioms SplitOrbitIdeal.pointIdeal_ne_top
#print axioms SplitOrbitIdeal.pointIdeal_not_invertible

end SplitOrbitIdeal
