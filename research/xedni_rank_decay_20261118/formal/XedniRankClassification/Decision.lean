/-
  Rank-bound decision logic for the Xedni rank-decay experiment. The separate
  computational certificate must establish that the integers supplied here
  are valid Mordell--Weil rank bounds.
-/

namespace XedniRankDecay

structure ValidRankBounds (lower actual upper : Nat) : Prop where
  lower_le_actual : lower ≤ actual
  actual_le_upper : actual ≤ upper

def CertLT (upper r : Nat) : Prop := upper < r

def CertGE (lower r : Nat) : Prop := r ≤ lower

theorem certLT_implies_actual_lt
    {lower actual upper r : Nat}
    (bounds : ValidRankBounds lower actual upper)
    (decision : CertLT upper r) : actual < r := by
  exact Nat.lt_of_le_of_lt bounds.actual_le_upper decision

theorem certGE_implies_actual_ge
    {lower actual upper r : Nat}
    (bounds : ValidRankBounds lower actual upper)
    (decision : CertGE lower r) : r ≤ actual := by
  exact Nat.le_trans decision bounds.lower_le_actual

theorem certified_classes_disjoint
    {lower actual upper r : Nat}
    (bounds : ValidRankBounds lower actual upper) :
    ¬ (CertLT upper r ∧ CertGE lower r) := by
  intro both
  have actual_lt : actual < r :=
    certLT_implies_actual_lt bounds both.1
  have r_le_actual : r ≤ actual :=
    certGE_implies_actual_ge bounds both.2
  exact (Nat.not_lt_of_ge r_le_actual) actual_lt

/-
`selectedRank` is the rank of the subgroup generated by the selected lifted
points. Its certification is a separate computational obligation. If that
subgroup rank is at most the curve rank and a certified upper bound is below
the number of selected points, then the subgroup rank is also below it.
-/
theorem certLT_implies_selected_rank_deficient
    {selectedRank lower actual upper r : Nat}
    (selected_le_curve : selectedRank ≤ actual)
    (bounds : ValidRankBounds lower actual upper)
    (decision : CertLT upper r) : selectedRank < r := by
  exact Nat.lt_of_le_of_lt
    (Nat.le_trans selected_le_curve bounds.actual_le_upper)
    decision

/- A useful recovery is deliberately not derivable from rank deficiency. -/
structure UsefulRecoveryCertificate (q targetCoefficient : Nat) : Prop where
  nonzero_modulus : 0 < q
  target_invertible : Nat.Coprime targetCoefficient q

end XedniRankDecay

#print axioms XedniRankDecay.certLT_implies_actual_lt
#print axioms XedniRankDecay.certGE_implies_actual_ge
#print axioms XedniRankDecay.certified_classes_disjoint
#print axioms XedniRankDecay.certLT_implies_selected_rank_deficient
