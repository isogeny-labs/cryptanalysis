#!/usr/bin/env bash
# Fixed public M31 lab curve. Build current source, then recover from coordinates.
set -euo pipefail
if [[ ${1:-} == --help || ${1:-} == -h ]]; then
  echo 'Usage: scripts/m31-fast QX QY [--seed N] [native worker options]'
  echo 'Fixed M31 lab curve; defaults B256/m2. JSON includes the complete certificate.'
  echo 'Exit: 0 checked recovery, 1 bounded incomplete, 2 invalid input/error.'
  exit 0
fi
if [[ $# -lt 2 ]]; then
  echo 'Usage: scripts/m31-fast QX QY [--seed N] [native worker options]' >&2
  exit 2
fi
repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
target_dir=${CARGO_TARGET_DIR:-"$repo_dir/crates/prime-field-auxiliary-ic/target"}
cargo +1.88.0 build --quiet --locked --release --manifest-path "$repo_dir/crates/prime-field-auxiliary-ic/Cargo.toml" --bin m31-fast >&2
qx=$1
qy=$2
shift 2
exec "$target_dir/release/m31-fast" --qx "$qx" --qy "$qy" "$@"
